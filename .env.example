# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# ---------------------------------------------------------------- required
# A Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---------------------------------------------------------------- models
# Google's model IDs change often, so these are configuration, not
# constants. Run `python scripts/smoke_test_llm.py --list` to see which
# IDs your key can actually use, then pin exact ones here.
#
# PLANNER_MODEL  the careful model: planning and re-planning
# FAST_MODEL     the cheap model: resolving arguments, probing, judging
#                (about four calls in five)
#
# Note: on the free tier the newest models allow roughly 20 requests per
# day. The -lite models have far more room. Each model has its own quota,
# so pointing these at two different models spreads the load.
PLANNER_MODEL=gemini-3.5-flash-lite
FAST_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------- folders
# Extra directories the agent's file tools may touch, as name=path pairs
# separated by semicolons. `sandbox` and `outputs` always exist.
# The agent refers to these by name -- "work/report.xlsx" -- so machine
# paths never appear in a plan a human has to read.
#
# WORKSPACES=work=C:/Users/you/Desktop/agent-files;docs=D:/reports
WORKSPACES=

# Where everything the agent produces is written. Defaults to
# <Desktop>/AI_colleage_outputs, kept separate from the material it was
# given so you can always tell its work from its inputs.
# OUTPUTS_DIR=C:/Users/you/Desktop/AI_colleage_outputs
OUTPUTS_DIR=

# ---------------------------------------------------------------- email
# Optional. Without these the agent still composes email in the browser,
# but cannot verify that a message was sent by reading the Sent folder.
#
# Must be an App Password, not your account password -- Gmail rejects
# account passwords over SMTP anyway. Create one at
# https://myaccount.google.com/apppasswords (needs 2-step verification).
# It is revocable on its own and cannot be used to sign in, which is why
# it is the right credential to give an agent.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------- limits
# Guards against the classic agent failure: looping while spending money.
MAX_STEPS=25                 # most steps one run may execute
MAX_STEP_ATTEMPTS=2          # tries per step, so 2 means one repair
MAX_REPLANS=1                # times a run may throw its plan away
LLM_MAX_RETRIES=3            # retries on a transient model error
MAX_OUTPUT_TOKENS=8192       # room for a long plan plus thinking tokens
